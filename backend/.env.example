# Authentication - MUST match frontend BETTER_AUTH_SECRET
BETTER_AUTH_SECRET=your-secret-here-min-32-chars-long-xxxxxxx

# Database (Neon PostgreSQL) - UPDATE THIS WITH YOUR NEON CONNECTION STRING
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# OpenAI API Key (Phase 3: AI Chatbot)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true
